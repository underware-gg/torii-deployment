# LOCAL runs only (`pnpm dev`, `pnpm docker:run`). Copy to .env.
#
# The deployed services do NOT read this file. NETWORK is baked into each generated
# deploy/torii-<net>/Dockerfile; anything else is a Railway service variable (dashboard).
#
# Optional values shown are the defaults, already set in the Dockerfile. NETWORK has no
# default anywhere — the container refuses to start without it.
# Precedence: CLI args > --config TOML > env > defaults.
# Keep notes above each line — `docker --env-file` does not strip inline comments.

# --- Required ---

# SN_MAIN | SN_SEPOLIA — which contracts.json section to index.
NETWORK=SN_MAIN

# --- Optional ---

# sqlite dir. Must be under a mounted volume in prod, or the index is lost on redeploy.
# TORII_DB_DIR=/data/torii-db

# false to boot without a volume (local only).
# REQUIRE_PERSISTENT_DB=true

# Overrides <NETWORK>.rpc_url in contracts.json.
# RPC_URL=

# Prometheus port. Keep off the public domain.
# METRICS_PORT=9200

# Comma separated. Set to your frontend origin in prod.
# CORS_ORIGINS=*

# CONTRACTS_JSON_PATH=/app/contracts.json
# GENERATED_TORII_TOML=/app/torii.generated.toml

# Whole contracts.json blob — overrides the baked file, no rebuild needed.
# CONTRACTS_JSON=

# --- Never set ---

# Railway injects PORT and the generated config binds to it (8080 locally).

# --- Docker build arg, not env ---

# TORII_VERSION=1.8.16
