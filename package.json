{
  "name": "torii-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Torii indexer deployment: config generation, Docker image, Railway ops",
  "license": "CC0-1.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "check": "node template/scripts/generate-torii-config.mjs --check -c ./contracts.json && node scripts/build-deploy.mjs --check",
    "test": "node --test test/*.test.mjs",
    "compare": "node scripts/compare-reference.mjs",
    "build": "node scripts/build-deploy.mjs",
    "config": "node template/scripts/generate-torii-config.mjs -c ./contracts.json -o ./torii.generated.toml -n ${NETWORK:-SN_MAIN}",
    "blocks": "node scripts/find-deploy-block.mjs -c ./contracts.json --update",
    "blocks:force": "node scripts/find-deploy-block.mjs -c ./contracts.json --update --force",
    "dev": "TORII_DB_DIR=./data/torii-db PORT=${PORT:-8080} pnpm run config && ${TORII_BIN:-torii} --config ./torii.generated.toml",
    "docker:build": "docker build -t torii-${DEPLOY:-mainnet} deploy/torii-${DEPLOY:-mainnet}",
    "docker:build:amd64": "docker build --platform linux/amd64 -t torii-${DEPLOY:-mainnet} deploy/torii-${DEPLOY:-mainnet}",
    "docker:run": "docker run --rm -it -p 8080:8080 -p 9200:9200 -e PORT=8080 -v torii-${DEPLOY:-mainnet}-db:/data torii-${DEPLOY:-mainnet}",
    "docker:shell": "docker run --rm -it --entrypoint bash torii-${DEPLOY:-mainnet}",
    "health:mainnet": "curl -fsS https://pistols-torii-mainnet.up.railway.app/health",
    "health:sepolia": "curl -fsS https://pistols-torii-sepolia.up.railway.app/health"
  },
  "engines": {
    "node": ">=20"
  }
}
